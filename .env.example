# ─── Common SaaS API Configuration ───────────────────────────────────────────
# See src/main/common-api-config.ts for all available options.

# Base URL of the Common SaaS API Gateway
GHOST_API_URL=https://api.ghostbrowser.app

# Optional API key for machine-to-machine authentication
# (leave empty to use JWT Bearer tokens from the login flow)
# GHOST_API_KEY=

# Request timeout in milliseconds (default: 30000)
# GHOST_API_TIMEOUT=30000

# Max retry attempts for rate-limited (429) requests (default: 3)
# GHOST_API_MAX_RETRIES=3

# Background cloud sync interval in milliseconds (default: 300000 = 5 min)
# GHOST_SYNC_INTERVAL=300000

# Notification polling interval in milliseconds (default: 60000 = 1 min)
# GHOST_NOTIFICATION_INTERVAL=60000

# Health check interval in milliseconds (default: 300000 = 5 min)
# GHOST_HEALTH_CHECK_INTERVAL=300000

# Offline request queue max size (default: 500)
# GHOST_OFFLINE_QUEUE_MAX=500

# Offline queue replay interval in milliseconds (default: 30000 = 30s)
# GHOST_OFFLINE_REPLAY_INTERVAL=30000

# Profile sync event batch delay in milliseconds (default: 2000 = 2s)
# GHOST_PROFILE_SYNC_BATCH_DELAY=2000
