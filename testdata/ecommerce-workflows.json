      {
        "id": "8efd4dc3-4cd2-4852-bba9-6a6ab9aacdf2",
        "action": "screenshot",
        "label": "Full product screenshot",
        "params": {
          "fullPage": true
        }
      }
    ],
    "variables": {
      "keyword": "iphone 15 pro max",
