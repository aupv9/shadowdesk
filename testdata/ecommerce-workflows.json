[
  {
    "id": "9c720183-73e0-4efa-9702-82fe5e9ff722",
    "name": "Shopee — Search & Extract Listings",
    "description": "Navigate to Shopee VN, search for a keyword, scroll the results page and extract the first 10 product titles + prices.",
    "platform": "shopee",
    "region": "VN",
    "tags": [
      "shopee",
      "vietnam",
      "search",
      "scraping"
    ],
    "category": "sea-ecommerce",
    "steps": [
      {
        "id": "5cfd3d6a-e640-4943-aaf0-39422533e922",
        "action": "navigate",
        "label": "Open Shopee VN",
        "params": {
          "url": "https://shopee.vn",
          "waitUntil": "networkidle2",
          "timeout": 30000
        }
      },
      {
        "id": "1e95455d-48bd-4d31-a28f-1bbd2e72a1e3",
        "action": "wait",
        "label": "Let hydration finish",
        "params": {
          "ms": 2500
        }
      },
      {
        "id": "465a2cae-7899-4493-a3e8-eeb82a8abd62",
        "action": "waitForSelector",
        "label": "Wait for search bar",
        "params": {
          "selector": "input.shopee-searchbar-input__input",
          "visible": true,
          "timeout": 15000
        }
      },
      {
        "id": "8156af24-35d6-4527-bc1e-b1dc9dbdf407",
        "action": "click",
        "label": "Focus search bar",
        "params": {
          "selector": "input.shopee-searchbar-input__input"
        }
      },
      {
        "id": "0ed2de10-18ca-4ab1-9414-263a5083d083",
        "action": "type",
        "label": "Type keyword",
        "params": {
          "selector": "input.shopee-searchbar-input__input",
          "text": "{keyword}",
          "delay": 85
        }
      },
      {
        "id": "b6a31f58-2eb5-46d9-8c58-d13716d00b51",
        "action": "keyPress",
        "label": "Submit search",
        "params": {
          "key": "Enter"
        }
      },
      {
        "id": "08dc6432-6c9b-45ea-bdb6-917fcd5fe9e2",
        "action": "waitForNavigation",
        "label": "Wait for results",
        "params": {
          "waitUntil": "networkidle2",
          "timeout": 30000
        }
      },
      {
        "id": "22cdcbb5-99de-4679-837a-4583a00cc972",
        "action": "waitForSelector",
        "label": "Wait for first product card",
        "params": {
          "selector": "div.shopee-search-item-result__item",
          "visible": true,
          "timeout": 15000
        }
      },
      {
        "id": "1b12e061-5841-43fb-b0af-7cc4cff75ed9",
        "action": "loop",
        "label": "Lazy-scroll results",
        "params": {
          "times": 4,
          "steps": [
            {
              "id": "4b764880-b100-42b0-98c5-18f78350d48a",
              "action": "scroll",
              "label": "Scroll down",
              "params": {
                "y": 900
              }
            },
            {
              "id": "30af06a7-f5eb-4cce-8c3b-6e8e49c861ce",
              "action": "wait",
              "label": "Human pause",
              "params": {
                "ms": 1200
              }
            }
          ]
        }
      },
      {
        "id": "61e6325d-e792-47e3-9d34-6673b9350bc9",
        "action": "extractText",
        "label": "Extract product titles",
        "params": {
          "selector": "div[data-sqe=\"name\"]",
          "all": true,
          "saveAs": "shopee_titles"
        }
      },
      {
        "id": "023fa001-6064-4a40-9074-24c0f662ecad",
        "action": "extractText",
        "label": "Extract product prices",
        "params": {
          "selector": "div.ZEgDH9",
          "all": true,
          "saveAs": "shopee_prices"
        }
      },
      {
        "id": "d427c8af-e701-4896-86b5-40c8748e844c",
        "action": "screenshot",
        "label": "Screenshot results",
        "params": {
          "fullPage": false
        }
      }
    ],
    "variables": {
      "keyword": "iphone 15 pro max",
      "productUrl": "https://shopee.vn/iPhone-15-Pro-Max-256GB-i.123.4567890",
      "shopee_user": "demo_user@example.com",
      "shopee_password": "DemoPass123!"
    },
    "profile_ids": [
      "b669e3da-1c4f-47ac-8957-e5e92290f4fe",
      "cdbf3e75-027e-424f-a560-cbae8271cfb2",
      "d1a78ef7-2a82-4913-8c8f-bc66e57b9efd"
    ]
  },
