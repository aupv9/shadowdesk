[
  {
    "id": "9c720183-73e0-4efa-9702-82fe5e9ff722",
    "name": "Shopee — Search & Extract Listings",
    "description": "Navigate to Shopee VN, search for a keyword, scroll the results page and extract the first 10 product titles + prices.",
    "platform": "shopee",
    "region": "VN",
    "tags": [
      "shopee",
      "vietnam",
      "search",
      "scraping"
    ],
    "category": "sea-ecommerce",
    "steps": [
      {
        "id": "dfeee77f-85e1-49e6-9373-7694e664be10",
        "action": "navigate",
        "label": "Open Shopee VN",
        "params": {
          "url": "https://shopee.vn",
          "waitUntil": "networkidle2",
          "timeout": 30000
        }
      },
      {
        "id": "d16225b9-8542-4492-aee3-29a5a88ff0fe",
        "action": "wait",
        "label": "Let hydration finish",
        "params": {
          "ms": 2500
        }
      },
      {
        "id": "79e00e8a-10b7-49d8-9825-0e82be972806",
        "action": "waitForSelector",
        "label": "Wait for search bar",
        "params": {
          "selector": "input.shopee-searchbar-input__input",
          "visible": true,
          "timeout": 15000
        }
      },
      {
        "id": "4f10d611-e3bf-4cf2-8d8a-5be0a13e294f",
        "action": "click",
        "label": "Focus search bar",
        "params": {
          "selector": "input.shopee-searchbar-input__input"
        }
      },
      {
        "id": "74d51569-6c21-4a50-8507-5fa18cf9a3dd",
        "action": "type",
        "label": "Type keyword",
        "params": {
          "selector": "input.shopee-searchbar-input__input",
          "text": "{keyword}",
          "delay": 85
        }
      },
      {
        "id": "6a491fc1-6ec0-43b0-9597-39dfe48236f3",
        "action": "keyPress",
        "label": "Submit search",
        "params": {
          "key": "Enter"
        }
      },
      {
        "id": "78ba3a79-041c-4d7d-a1b4-da371dbae54a",
        "action": "waitForNavigation",
        "label": "Wait for results",
        "params": {
          "waitUntil": "networkidle2",
          "timeout": 30000
        }
      },
      {
        "id": "604d3180-8874-4bf3-ac9d-bd04d19a66ab",
        "action": "waitForSelector",
        "label": "Wait for first product card",
        "params": {
          "selector": "div.shopee-search-item-result__item",
          "visible": true,
          "timeout": 15000
        }
      },
      {
        "id": "c82965f1-e6f1-46e9-98e5-66557cfcf5e8",
        "action": "loop",
        "label": "Lazy-scroll results",
        "params": {
          "times": 4,
          "steps": [
            {
              "id": "c514f50b-dd28-4b5f-a512-8f20e1cea407",
              "action": "scroll",
              "label": "Scroll down",
              "params": {
                "y": 900
              }
            },
            {
              "id": "2032ce21-1cde-410c-a770-24373dd2b9e0",
              "action": "wait",
              "label": "Human pause",
              "params": {
                "ms": 1200
              }
            }
          ]
        }
      },
      {
        "id": "5109558a-1e8e-468f-b738-a6be92ed80a8",
        "action": "extractText",
        "label": "Extract product titles",
        "params": {
          "selector": "div[data-sqe=\"name\"]",
          "all": true,
          "saveAs": "shopee_titles"
        }
      },
      {
        "id": "d4a10014-4c37-4fce-8d82-177347763631",
        "action": "extractText",
        "label": "Extract product prices",
        "params": {
          "selector": "div.ZEgDH9",
          "all": true,
          "saveAs": "shopee_prices"
        }
      },
      {
        "id": "0c49b5a2-6ce4-4058-a12d-eea3861aa17e",
        "action": "screenshot",
        "label": "Screenshot results",
        "params": {
          "fullPage": false
        }
      }
    ],
    "variables": {
      "keyword": "iphone 15 pro max",
      "productUrl": "https://shopee.vn/iPhone-15-Pro-Max-256GB-i.123.4567890",
      "shopee_user": "demo_user@example.com",
      "shopee_password": "DemoPass123!"
    },
    "profile_ids": [
      "b669e3da-1c4f-47ac-8957-e5e92290f4fe",
