[
  {
    "id": "9c720183-73e0-4efa-9702-82fe5e9ff722",
    "name": "Shopee — Search & Extract Listings",
    "description": "Navigate to Shopee VN, search for a keyword, scroll the results page and extract the first 10 product titles + prices.",
    "platform": "shopee",
    "region": "VN",
    "tags": [
      "shopee",
      "vietnam",
      "search",
      "scraping"
    ],
    "category": "sea-ecommerce",
    "steps": [
      {
        "id": "4e4d86db-2246-4479-8828-d2ec78df4cdb",
        "action": "navigate",
        "label": "Open Shopee VN",
        "params": {
          "url": "https://shopee.vn",
          "waitUntil": "networkidle2",
          "timeout": 30000
        }
      },
      {
        "id": "65bdfd84-56df-440b-8f48-7fc1ed398272",
        "action": "wait",
        "label": "Let hydration finish",
        "params": {
          "ms": 2500
        }
      },
      {
        "id": "678e3b46-61b8-4eb6-a625-0cdb9b9da11b",
        "action": "waitForSelector",
        "label": "Wait for search bar",
        "params": {
          "selector": "input.shopee-searchbar-input__input",
          "visible": true,
          "timeout": 15000
        }
      },
      {
        "id": "4bee9f5c-e841-4141-8d81-536738e8d223",
        "action": "click",
        "label": "Focus search bar",
        "params": {
          "selector": "input.shopee-searchbar-input__input"
        }
      },
      {
        "id": "6d2546ad-29eb-4d59-9dfc-e4c6038c1c6a",
        "action": "type",
        "label": "Type keyword",
        "params": {
          "selector": "input.shopee-searchbar-input__input",
          "text": "{keyword}",
          "delay": 85
        }
      },
      {
        "id": "888ef0c2-5b85-4aa8-bab8-8c4705a9c5a7",
        "action": "keyPress",
        "label": "Submit search",
        "params": {
          "key": "Enter"
        }
      },
      {
        "id": "ef272d69-556b-4f8a-ad21-ae8b23178de6",
        "action": "waitForNavigation",
        "label": "Wait for results",
        "params": {
          "waitUntil": "networkidle2",
          "timeout": 30000
        }
      },
      {
        "id": "e0e5e5c6-00d8-4bdd-94ae-4239b81291df",
        "action": "waitForSelector",
        "label": "Wait for first product card",
        "params": {
          "selector": "div.shopee-search-item-result__item",
          "visible": true,
          "timeout": 15000
        }
      },
      {
        "id": "9f11aed1-dd1d-40b4-b8c3-7d2dad6a1af3",
        "action": "loop",
        "label": "Lazy-scroll results",
        "params": {
          "times": 4,
          "steps": [
            {
              "id": "0a4e54e9-bccb-42a8-abac-391c00d1b47e",
              "action": "scroll",
              "label": "Scroll down",
              "params": {
                "y": 900
              }
            },
            {
              "id": "4219cc15-858a-4e5a-b118-f97040a97e9a",
              "action": "wait",
              "label": "Human pause",
              "params": {
                "ms": 1200
              }
            }
          ]
        }
      },
      {
        "id": "561a7af5-130e-4652-a547-6075592b6cbd",
        "action": "extractText",
        "label": "Extract product titles",
        "params": {
          "selector": "div[data-sqe=\"name\"]",
          "all": true,
          "saveAs": "shopee_titles"
        }
      },
      {
        "id": "0e7630b7-724d-48d2-ac8d-f195765548a0",
        "action": "extractText",
        "label": "Extract product prices",
        "params": {
          "selector": "div.ZEgDH9",
          "all": true,
          "saveAs": "shopee_prices"
        }
      },
      {
        "id": "e0506276-a191-47d4-b8f2-6c1ba4637f1c",
        "action": "screenshot",
        "label": "Screenshot results",
        "params": {
          "fullPage": false
        }
      }
    ],
    "variables": {
      "keyword": "iphone 15 pro max",
      "productUrl": "https://shopee.vn/iPhone-15-Pro-Max-256GB-i.123.4567890",
      "shopee_user": "demo_user@example.com",
      "shopee_password": "DemoPass123!"
    },
    "profile_ids": [
      "b669e3da-1c4f-47ac-8957-e5e92290f4fe",
      "cdbf3e75-027e-424f-a560-cbae8271cfb2",
      "d1a78ef7-2a82-4913-8c8f-bc66e57b9efd"
    ]
  },
