  {
    "id": "3847704f-52de-4404-9344-d0f0309f50cc",
    "name": "Conditional Login Flow",
    "description": "Check if logged in, if not then login",
    "profileIds": [
      "824c0946-ef21-40ec-ae97-f09b5e589dab",
      "2529d0d6-4d23-41b8-a7d3-00e772616714"
    ],
    "steps": [
      {
        "id": "1ce7220f-ec34-42aa-93f4-3f1260eb1e8e",
        "type": "navigate",
        "name": "Navigate to Dashboard",
        "params": {
          "url": "https://example.com/dashboard"
        },
        "timeout": 10000
      },
      {
        "id": "0cccdc23-bfcf-40d3-af10-f6131f402be2",
        "type": "condition",
        "name": "Check If Logged In",
        "params": {
          "selector": ".user-profile",
          "type": "exists",
          "then": [
            {
              "id": "4db821be-8304-45f7-89e4-2829e01dcc58",
              "type": "log",
              "name": "Already Logged In",
              "params": {
                "message": "User is already logged in"
              }
            }
          ],
          "else": [
            {
              "id": "e31a5373-2655-4fd5-a337-9f7525f13dbf",
              "type": "navigate",
              "name": "Go to Login Page",
              "params": {
                "url": "https://example.com/login"
              }
            },
            {
              "id": "edb7855b-1dd1-4ee9-b41a-eefc20d1b27a",
              "type": "fill",
              "name": "Enter Email",
              "selector": "input[type=\"email\"]",
              "params": {
                "value": "test@example.com"
              }
            },
            {
              "id": "c7edf761-0cf5-47b2-9b25-4d229bd638d1",
              "type": "fill",
              "name": "Enter Password",
              "selector": "input[type=\"password\"]",
              "params": {
                "value": "TestPassword123!"
              }
            },
            {
              "id": "972575a9-851f-4ff4-8def-bd46a9decdec",
              "type": "click",
              "name": "Click Login Button",
              "selector": "button[type=\"submit\"]"
            }
          ]
        }
      },
      {
        "id": "4dfa3caa-892b-4665-8b40-348fc82f057a",
        "type": "screenshot",
        "name": "Final Screenshot",
        "params": {
          "fullPage": true
        }
      }
    ],
    "created_at": "2026-04-08T08:07:27.228Z",
    "updated_at": "2026-04-08T08:07:27.228Z"
  },
  {
    "id": "4f483a59-3563-4c53-873b-c6e283519c14",
    "name": "Loop - Scrape Product List",
    "description": "Loop through products and extract data",
    "profileIds": [
      "2529d0d6-4d23-41b8-a7d3-00e772616714"
    ],
    "steps": [
      {
        "id": "335a72d7-960f-4f7f-863b-9a952d7e54d6",
        "type": "navigate",
        "name": "Navigate to Products",
        "params": {
          "url": "https://example.com/products"
        },
        "timeout": 10000
      },
      {
        "id": "c41d1efc-9e7e-4084-84be-b0073156ff3b",
        "type": "loop",
        "name": "Extract Product Information",
        "params": {
          "selector": ".product-card",
          "actions": [
            {
              "id": "86af10c1-1fc6-42b4-ab43-e592b6b8dc4e",
              "type": "extract",
              "name": "Get Product Title",
              "selector": ".product-title",
              "params": {
                "attribute": "text"
              }
            },
            {
              "id": "69ef6c06-a3f7-408f-9bb3-93c5149ba6bc",
              "type": "extract",
              "name": "Get Product Price",
              "selector": ".product-price",
              "params": {
                "attribute": "text",
                "regex": "\\$([0-9.]+)"
              }
            },
            {
              "id": "0bbc6f67-2475-4a57-8a5f-15f31adc54f0",
              "type": "extract",
              "name": "Get Product Link",
              "selector": "a.product-link",
              "params": {
                "attribute": "href"
              }
            },
            {
              "id": "83e4cb2d-5dc2-48a1-a8fc-1f694db392d8",
              "type": "log",
              "name": "Log Product Data",
              "params": {
                "message": "Extracted product: {{title}} - {{price}}"
              }
            }
          ]
        }
      }
    ],
    "created_at": "2026-04-08T08:07:27.228Z",
    "updated_at": "2026-04-08T08:07:27.228Z"
  },
  {
