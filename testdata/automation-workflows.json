    ],
    "steps": [
      {
        "id": "8f69243e-e408-4a0b-936b-b6af17e252a9",
        "type": "navigate",
        "name": "Navigate to Example",
        "description": "Open example.com",
        "params": {
          "url": "https://example.com"
        },
        "timeout": 10000
      },
      {
        "id": "0cc6bf40-4ca0-4e0a-941f-74074917a2ab",
        "type": "wait",
        "name": "Wait for Page Load",
