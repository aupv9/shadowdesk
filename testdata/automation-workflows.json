  {
    "id": "fd8072d2-0ea6-46d4-ab23-e334aa819ff3",
    "name": "Conditional Login Flow",
    "description": "Check if logged in, if not then login",
    "profileIds": [
      "4fd515eb-1802-4f4a-8d5d-6bfdf70f67cb",
      "b119a771-c805-4677-871d-5c8696529927"
    ],
    "steps": [
      {
        "id": "86784a2b-258a-4c7c-9a2a-bcdf3226a87b",
        "type": "navigate",
        "name": "Navigate to Dashboard",
        "params": {
          "url": "https://example.com/dashboard"
        },
        "timeout": 10000
      },
      {
        "id": "449a0f52-11a8-414a-b551-c7b572849a65",
        "type": "condition",
        "name": "Check If Logged In",
        "params": {
          "selector": ".user-profile",
          "type": "exists",
          "then": [
            {
              "id": "8498210b-c0fb-4edc-a762-58c3243f5601",
              "type": "log",
              "name": "Already Logged In",
              "params": {
                "message": "User is already logged in"
              }
            }
          ],
          "else": [
            {
              "id": "70399088-9c9f-43b9-bdc8-6db7ca79f398",
              "type": "navigate",
              "name": "Go to Login Page",
              "params": {
                "url": "https://example.com/login"
              }
            },
            {
              "id": "cbcc0893-6457-4a7f-a217-caf8bda04e83",
              "type": "fill",
              "name": "Enter Email",
              "selector": "input[type=\"email\"]",
              "params": {
                "value": "test@example.com"
              }
            },
            {
              "id": "bdb9c27d-aa9d-4aae-ad0b-93e835128dc0",
              "type": "fill",
              "name": "Enter Password",
              "selector": "input[type=\"password\"]",
              "params": {
                "value": "TestPassword123!"
              }
            },
            {
              "id": "c1dee9fc-83b1-40a9-a9f2-5cea191408c1",
              "type": "click",
              "name": "Click Login Button",
              "selector": "button[type=\"submit\"]"
            }
          ]
        }
      },
      {
        "id": "ed4400f8-6bee-40e4-93a8-45e8a0001026",
        "type": "screenshot",
        "name": "Final Screenshot",
        "params": {
          "fullPage": true
        }
      }
    ],
    "created_at": "2026-04-08T07:53:12.408Z",
    "updated_at": "2026-04-08T07:53:12.408Z"
  },
  {
    "id": "16e31b63-1383-4c71-9f9c-30f03aa63ff6",
    "name": "Loop - Scrape Product List",
    "description": "Loop through products and extract data",
    "profileIds": [
      "b119a771-c805-4677-871d-5c8696529927"
    ],
    "steps": [
      {
        "id": "00569c45-3834-4dcc-aeac-20dd8511ee4a",
        "type": "navigate",
        "name": "Navigate to Products",
        "params": {
          "url": "https://example.com/products"
        },
        "timeout": 10000
      },
      {
        "id": "a9405b31-020b-400d-bd10-f250c9b86915",
        "type": "loop",
        "name": "Extract Product Information",
        "params": {
          "selector": ".product-card",
          "actions": [
            {
              "id": "9fffdedf-9d4d-496b-8298-ae708e59470a",
              "type": "extract",
              "name": "Get Product Title",
              "selector": ".product-title",
              "params": {
                "attribute": "text"
              }
            },
            {
              "id": "5eed6d27-19ac-4e3f-8419-08c3a982e546",
              "type": "extract",
              "name": "Get Product Price",
              "selector": ".product-price",
              "params": {
                "attribute": "text",
                "regex": "\\$([0-9.]+)"
              }
            },
            {
              "id": "ee45230c-bef0-455c-9f31-e7949386bd0b",
              "type": "extract",
              "name": "Get Product Link",
              "selector": "a.product-link",
              "params": {
                "attribute": "href"
              }
            },
            {
              "id": "852e2c20-503c-4a34-baea-ce9d9004b089",
              "type": "log",
              "name": "Log Product Data",
              "params": {
                "message": "Extracted product: {{title}} - {{price}}"
              }
            }
          ]
        }
      }
    ],
    "created_at": "2026-04-08T07:53:12.408Z",
    "updated_at": "2026-04-08T07:53:12.408Z"
  },
  {
