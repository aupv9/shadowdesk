  {
    "id": "f37241fb-5dc8-4c4f-8797-7e46388ec8af",
    "name": "API Call & Data Processing",
    "description": "Make API call and process response",
    "profileIds": [
      "3f995308-9f90-431a-a728-d1e1e9536572"
    ],
    "steps": [
      {
        "id": "f38bf48a-44e8-4cd6-a667-ce0dfea9e847",
        "type": "api_call",
        "name": "Fetch User Data",
        "params": {
          "url": "https://jsonplaceholder.typicode.com/users/1",
          "method": "GET",
          "headers": {
            "Content-Type": "application/json"
          }
        },
        "timeout": 10000
      },
      {
        "id": "75c0c33a-ee38-474e-9c4f-28455356fbbe",
        "type": "js_execute",
        "name": "Process API Response",
        "params": {
          "code": "\n            const userData = JSON.parse(context.apiResponse);\n            return {\n              name: userData.name,\n              email: userData.email,\n              company: userData.company.name\n            };\n          "
        }
      },
      {
        "id": "851bd6d4-4fe4-4368-a424-e89994199044",
        "type": "navigate",
        "name": "Navigate to Form",
        "params": {
          "url": "https://httpbin.org/post"
        },
        "timeout": 10000
      },
      {
        "id": "b1ed1ba1-54cf-471f-9510-f076bb5d2265",
        "type": "fill",
        "name": "Fill with API Data",
        "selector": "input[name=\"name\"]",
        "params": {
          "value": "{{processedData.name}}"
        }
      },
      {
        "id": "98699ed5-29e4-48dc-a0d4-8bbe699a155f",
        "type": "fill",
        "name": "Fill Email",
        "selector": "input[name=\"email\"]",
        "params": {
          "value": "{{processedData.email}}"
        }
      },
      {
        "id": "3534b834-c71b-42ff-aea5-d662aef65564",
        "type": "click",
        "name": "Submit",
        "selector": "button[type=\"submit\"]"
      }
    ],
    "created_at": "2026-04-08T07:53:12.408Z",
    "updated_at": "2026-04-08T07:53:12.408Z"
  },
  {
    "id": "26a6a746-3244-4027-becf-5a6001728675",
    "name": "Error Handling & Retry",
    "description": "Handle errors gracefully with retries",
    "profileIds": [
      "4fd515eb-1802-4f4a-8d5d-6bfdf70f67cb"
    ],
    "steps": [
      {
        "id": "b8dbcee3-c522-47bd-86b6-9f66257aea1d",
        "type": "navigate",
        "name": "Navigate to Unreliable Service",
        "params": {
          "url": "https://example.com/unstable"
        },
        "timeout": 10000,
        "retries": 3,
        "skipOnError": false
      },
      {
        "id": "6dd24f26-bcb9-4976-8e33-7176798cbea3",
        "type": "wait",
        "name": "Wait for Element",
        "params": {
          "selector": ".dynamic-content",
          "type": "visible"
        },
        "timeout": 5000,
        "retries": 2,
        "skipOnError": true
      },
      {
        "id": "e7949e0f-dc68-4326-a676-ac8c3edb1a86",
        "type": "condition",
        "name": "Check If Retries Exhausted",
        "params": {
          "type": "expression",
          "expression": "context.lastError !== null",
          "then": [
            {
              "id": "37b7def7-fcb7-4261-a85f-d5587fb9e3b3",
              "type": "log",
              "name": "Log Error",
              "params": {
                "message": "Failed after retries: {{context.lastError}}"
              }
            },
            {
              "id": "f0ebf8a6-e476-4097-b9e8-c6fcf1b14270",
              "type": "api_call",
              "name": "Send Error Report",
              "params": {
                "url": "https://example.com/api/report-error",
                "method": "POST",
                "body": {
                  "error": "{{context.lastError}}",
                  "timestamp": "{{timestamp}}"
                }
              }
            }
          ]
        }
      }
    ],
    "created_at": "2026-04-08T07:53:12.408Z",
    "updated_at": "2026-04-08T07:53:12.408Z"
  },
