    "profileIds": [
      "824c0946-ef21-40ec-ae97-f09b5e589dab"
    ],
    "steps": [
      {
        "id": "978ac53d-4f9c-48b9-9112-a7656c267d4c",
        "type": "navigate",
        "name": "Navigate to Example",
        "description": "Open example.com",
        "params": {
          "url": "https://example.com"
        },
        "timeout": 10000
      },
      {
        "id": "45d700e1-c393-4989-9f8c-548970bd2c25",
        "type": "wait",
        "name": "Wait for Page Load",
        "params": {
          "selector": "body",
          "type": "visible"
        },
        "timeout": 5000
      },
      {
        "id": "a0c022ce-d2bb-40b0-9f90-20779266e314",
        "type": "screenshot",
        "name": "Capture Screenshot",
