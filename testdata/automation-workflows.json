  {
    "id": "38e28b94-fde0-4561-92ad-01da3e0c3785",
    "name": "API Call & Data Processing",
    "description": "Make API call and process response",
    "profileIds": [
      "742c2f80-8e81-44e6-85ef-6386f1d8292e"
    ],
    "steps": [
      {
        "id": "c3b80793-645a-4286-b65f-290fd1316e90",
        "type": "api_call",
        "name": "Fetch User Data",
        "params": {
          "url": "https://jsonplaceholder.typicode.com/users/1",
          "method": "GET",
          "headers": {
            "Content-Type": "application/json"
          }
        },
        "timeout": 10000
      },
      {
        "id": "a5fb599b-46fd-4ad8-89f9-39dc5108a144",
        "type": "js_execute",
        "name": "Process API Response",
        "params": {
          "code": "\n            const userData = JSON.parse(context.apiResponse);\n            return {\n              name: userData.name,\n              email: userData.email,\n              company: userData.company.name\n            };\n          "
        }
      },
      {
        "id": "e8675ff5-8447-4d6c-a6ee-07b14410a6e1",
        "type": "navigate",
        "name": "Navigate to Form",
        "params": {
          "url": "https://httpbin.org/post"
        },
        "timeout": 10000
      },
      {
        "id": "db7c7771-42af-4a3d-987d-646b2d86927f",
        "type": "fill",
        "name": "Fill with API Data",
        "selector": "input[name=\"name\"]",
        "params": {
          "value": "{{processedData.name}}"
        }
      },
      {
        "id": "b585d8d0-770d-47a7-a1cc-23df11e26a11",
        "type": "fill",
        "name": "Fill Email",
        "selector": "input[name=\"email\"]",
        "params": {
          "value": "{{processedData.email}}"
        }
      },
      {
        "id": "f2a5397f-82a4-4651-8da2-67607959bafc",
        "type": "click",
        "name": "Submit",
        "selector": "button[type=\"submit\"]"
      }
    ],
    "created_at": "2026-04-08T08:07:27.229Z",
    "updated_at": "2026-04-08T08:07:27.229Z"
  },
  {
    "id": "0b199f34-0479-47d0-96bb-9003843ed930",
    "name": "Error Handling & Retry",
    "description": "Handle errors gracefully with retries",
    "profileIds": [
      "824c0946-ef21-40ec-ae97-f09b5e589dab"
    ],
    "steps": [
      {
        "id": "51f2d56d-70a7-4894-bae8-f1c1b0a5a5f8",
        "type": "navigate",
        "name": "Navigate to Unreliable Service",
        "params": {
          "url": "https://example.com/unstable"
        },
        "timeout": 10000,
        "retries": 3,
        "skipOnError": false
      },
      {
        "id": "f91c8dbe-7093-4cc5-90e2-201cc83e73e1",
        "type": "wait",
        "name": "Wait for Element",
        "params": {
          "selector": ".dynamic-content",
          "type": "visible"
        },
        "timeout": 5000,
        "retries": 2,
        "skipOnError": true
      },
      {
        "id": "4e6f93bf-b73b-43bc-9c92-20f9dabadb66",
        "type": "condition",
        "name": "Check If Retries Exhausted",
        "params": {
          "type": "expression",
          "expression": "context.lastError !== null",
          "then": [
            {
              "id": "2c1fdd67-7b59-4ca6-aa61-00b11716511c",
              "type": "log",
              "name": "Log Error",
              "params": {
                "message": "Failed after retries: {{context.lastError}}"
              }
            },
            {
              "id": "db1f7d15-d0b7-4d58-a0e3-d1c4a58f574c",
              "type": "api_call",
              "name": "Send Error Report",
              "params": {
                "url": "https://example.com/api/report-error",
                "method": "POST",
                "body": {
                  "error": "{{context.lastError}}",
                  "timestamp": "{{timestamp}}"
                }
              }
            }
          ]
        }
      }
    ],
    "created_at": "2026-04-08T08:07:27.229Z",
    "updated_at": "2026-04-08T08:07:27.229Z"
  },
