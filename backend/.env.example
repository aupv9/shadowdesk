# Server
NODE_ENV=development
PORT=3000
API_BASE_URL=http://localhost:3000

# Database (PostgreSQL)
DATABASE_URL=postgresql://shadow:shadow@localhost:5432/shadowdesk

# Redis
REDIS_URL=redis://localhost:6379

# Auth — MUST change in production (min 32 chars)
JWT_SECRET=change-me-to-32-plus-random-chars-in-prod
JWT_ACCESS_TTL=900       # 15 minutes
JWT_REFRESH_TTL=2592000  # 30 days

# Email (Resend recommended)
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend
SMTP_PASS=re_xxxxxxxx
EMAIL_FROM=noreply@shadowdesk.io

# Supabase Storage (for sync bundles)
# SUPABASE_URL=https://xxx.supabase.co
# SUPABASE_SERVICE_KEY=eyJxxx
# SYNC_BUCKET=sync-bundles

# CORS (comma-separated origins or * for all)
CORS_ORIGINS=*
