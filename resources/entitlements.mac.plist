<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- V8 compiles JS to native code at runtime. -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>

    <!-- Electron passes env vars to its helper processes. -->
    <key>com.apple.security.cs.allow-dyld-environment-variables</key>
    <true/>

    <!-- The app launches an external Chrome/Chromium binary it did not sign. -->
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>

    <!-- Proxy checks, captcha providers, update downloads. -->
    <key>com.apple.security.network.client</key>
    <true/>
    <!-- Local automation API server (default port 9222). -->
    <key>com.apple.security.network.server</key>
    <true/>

    <!-- Profile bundle import/export and extension folder picking. -->
    <key>com.apple.security.files.user-selected.read-write</key>
    <true/>
</dict>
</plist>
